# Public site URL used for canonical/Open Graph metadata.
# Production must be https://www.studiojeker.ch
# Do not set preview tunnel URLs in committed env files.
NEXT_PUBLIC_SITE_URL=https://www.studiojeker.ch

# Headless WordPress REST API base URL (Metanet-hosted CMS) — SERVER ONLY.
# Must be HTTPS. Example: https://cms.example.com
# Leave unset for builds without a live CMS connection.
# Never expose as NEXT_PUBLIC_*.
WORDPRESS_API_BASE_URL=

# Contact form delivery webhook — SERVER ONLY.
# When set, POST /api/contact forwards validated JSON to this HTTPS URL.
CONTACT_FORM_WEBHOOK_URL=

# Cloudflare Turnstile (optional) — enable later without redesigning the form.
# Site key may be public; secret must stay server-only.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
