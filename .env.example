# Public site URL used for canonical/Open Graph metadata.
# Production / staging builds should use the real HTTPS host.
# Do not set preview tunnel URLs in committed env files.
NEXT_PUBLIC_SITE_URL=https://www.studiojeker.ch

# Optional override for the contact form POST URL (baked in at build time).
# Default (recommended on Metanet): /api/contact.php — leave unset.
# Never put secrets or API keys in NEXT_PUBLIC_* variables.
# NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=/api/contact.php

# Sanity CMS — Homepage content source (fetched at build time).
# Project / dataset are public identifiers; defaults are baked into the app.
NEXT_PUBLIC_SANITY_PROJECT_ID=tgx6e6jg
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Optional read token for drafts / private datasets — SERVER ONLY.
# Never expose as NEXT_PUBLIC_*. Published content needs no token.
# SANITY_API_READ_TOKEN=
# Write token for one-off content migration scripts — SERVER ONLY.
# SANITY_API_WRITE_TOKEN=

# Headless WordPress REST API base URL — SERVER ONLY (future CMS builds).
# Not required for Metanet static export of the marketing site.
# Must be HTTPS. Never expose as NEXT_PUBLIC_*.
WORDPRESS_API_BASE_URL=

# Cloudflare Turnstile (optional) — enable later without redesigning the form.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
