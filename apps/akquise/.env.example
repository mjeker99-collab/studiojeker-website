# DEVELOPMENT ONLY: copy to .env locally. Existing .env and database must be preserved.
# Production: use deploy/production.env.example and a server-side secret store.
DATABASE_URL=postgresql://akquise:local_only_change_me@localhost:5433/akquise?schema=public
# In production: mandatory canonical HTTPS origin without path, e.g. https://akquise.studiojeker.ch
APP_URL=http://localhost:3100
# Optional Google Drive connection; see docs/GOOGLE_DRIVE.md
DRIVE_CLIENT_ID=
DRIVE_CLIENT_SECRET=
DRIVE_TOKEN_ENCRYPTION_KEY=
# Optional Mailchimp Marketing API key (ends in -dc, e.g. -us21).
# Store server-side only. Enables audience lookup and explicit draft transfer.
MAILCHIMP_API_KEY=
# NODE_ENV is set by Next.js locally and by the production launcher/container on the host.
# Runtime listener; internal port only, HTTPS terminates at the reverse proxy.
PORT=3100
# Production allowlist: actual, distinct personal login addresses. No demo/default accounts.
MARTIN_EMAIL=
NORA_EMAIL=
# Safe default. local = MIME simulation only; test = ONLY fixed internal recipients;
# production = contact recipient. SMTP also needs both switches below set to true.
MAIL_MODE=disabled
ENABLE_EMAIL_SENDING=false
# Set true ONLY after Metanet has confirmed the exact account, port and TLS configuration.
SMTP_CONFIGURATION_CONFIRMED=false
SMTP_HOST=jovinus.metanet.ch
# Intentionally empty; confirm with Metanet. 465 typically implicit TLS, 587 STARTTLS.
SMTP_PORT=
# true = implicit TLS, false = mandatory STARTTLS. TLS certificate checks cannot be disabled.
SMTP_SECURE=
SMTP_USER=njeker@studiojeker.ch
# Server-side secret; never NEXT_PUBLIC_* or Git.
SMTP_PASSWORD=
MAIL_FROM=njeker@studiojeker.ch
# Comma-separated internal @studiojeker.ch addresses. Required in test mode, no wildcards.
TEST_MAIL_RECIPIENTS=
# UTC day; all network claims incl. failures count. Local simulations also have a limit.
DAILY_SEND_LIMIT=20
# Optional manually triggered read-only Sheets import. All three credentials required together.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Kontakte!A1:N501
GOOGLE_CLIENT_EMAIL=
# Service-account private key; actual newlines or escaped \n, server-side only.
GOOGLE_PRIVATE_KEY=
# Reserved: IMAP is not connected and no background reply/follow-up process runs.
IMAP_HOST=
IMAP_PORT=
IMAP_USER=
IMAP_PASSWORD=
# Optional migration-only privileged URL for deployment tooling; never exposed to the browser.
MIGRATION_DATABASE_URL=
# Compose-only infrastructure settings (not needed locally):
APP_DOMAIN=
ACME_EMAIL=
POSTGRES_PASSWORD=

# Optional server-side pool limit (1..10); Render small setup uses 3.
DATABASE_CONNECTION_LIMIT=

# CONTENT-STUDIO – all values below are server-only; no NEXT_PUBLIC_ keys.
# AI stays disconnected until both an API key and explicit enable flag are set.
# A ChatGPT subscription does not provide API credit. Never commit a real key.
CONTENT_AI_ENABLED=false
OPENAI_API_KEY=
CONTENT_TEXT_MODEL=gpt-4.1-mini
CONTENT_IMAGE_MODEL=gpt-image-1.5
# Daily UTC request and reservation limits. Reservations are planning estimates,
# NOT guaranteed provider charges or a provider-side hard spending cap.
CONTENT_DAILY_REQUEST_LIMIT=20
CONTENT_DAILY_BUDGET_USD=5
CONTENT_TEXT_RESERVE_USD=0.10
CONTENT_IMAGE_RESERVE_USD=0.25
# Private S3-compatible object storage (e.g. R2). Bucket public access must be OFF.
# Set an EU jurisdiction/location when creating the bucket if required.
STUDIO_S3_ENDPOINT=
STUDIO_S3_REGION=auto
STUDIO_S3_BUCKET=
STUDIO_S3_ACCESS_KEY_ID=
STUDIO_S3_SECRET_ACCESS_KEY=
# Local development only; files remain in ignored .local/studio-assets.
# This flag NEVER enables filesystem storage in NODE_ENV=production.
STUDIO_LOCAL_ASSETS=true
