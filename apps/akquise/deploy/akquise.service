[Unit]
Description=Studiojeker acquisition platform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=akquise
Group=akquise
WorkingDirectory=/opt/studiojeker-akquise/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/studiojeker-akquise/runtime.env
ExecStart=/usr/bin/node scripts/start-production.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/studiojeker-akquise/current/.next/cache
UMask=0077

[Install]
WantedBy=multi-user.target
