# Copy to deploy/production.env on the dedicated host; chmod 600. Never commit real values.
# Encode special characters in database URLs. Generate unique passwords in your secret manager.
APP_URL=https://akquise.studiojeker.ch
APP_DOMAIN=akquise.studiojeker.ch
ACME_EMAIL=
PORT=3100
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://akquise:REPLACE_WITH_URL_ENCODED_DATABASE_SECRET@db:5432/akquise?schema=public
# Optional admin connection for migrations; blank uses DATABASE_URL.
MIGRATION_DATABASE_URL=
MARTIN_EMAIL=
NORA_EMAIL=
MAIL_MODE=disabled
MAILCHIMP_API_KEY=
ENABLE_EMAIL_SENDING=false
SMTP_CONFIGURATION_CONFIRMED=false
SMTP_HOST=jovinus.metanet.ch
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=njeker@studiojeker.ch
SMTP_PASSWORD=
MAIL_FROM=njeker@studiojeker.ch
TEST_MAIL_RECIPIENTS=
DAILY_SEND_LIMIT=20
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Kontakte!A1:N501
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=


# ChatGPT read-only connector (server-only Bearer). Never NEXT_PUBLIC_*.
# See docs/CHATGPT_CONNECTOR.md. Leave empty until intentionally enabled.
CHATGPT_CONNECTOR_TOKEN=

# StudioONE Content-Studio (server-only). Own content does not require OpenAI.
# Leave disabled/unset for manual creation, layouts, approval and exports.
CONTENT_AI_ENABLED=false
OPENAI_API_KEY=
CONTENT_TEXT_MODEL=gpt-4.1-mini
CONTENT_IMAGE_MODEL=gpt-image-1.5
CONTENT_DAILY_REQUEST_LIMIT=20
CONTENT_DAILY_BUDGET_USD=5
CONTENT_TEXT_RESERVE_USD=0.10
CONTENT_IMAGE_RESERVE_USD=0.25
# REQUIRED for private photos/fonts/motifs/exports in production, independently
# of AI. Use an existing private S3-compatible bucket; never a public bucket.
STUDIO_S3_ENDPOINT=
STUDIO_S3_REGION=auto
STUDIO_S3_BUCKET=
STUDIO_S3_ACCESS_KEY_ID=
STUDIO_S3_SECRET_ACCESS_KEY=
# Never use Render's ephemeral filesystem as the authoritative media store.
STUDIO_LOCAL_ASSETS=false
