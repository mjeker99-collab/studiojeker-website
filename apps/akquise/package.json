{
  "name": "studiojeker-akquise",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0 --port 3100",
    "build": "next build --webpack",
    "start": "next start --port 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "user:create": "tsx --env-file=.env scripts/create-user.ts",
    "db:local": "tsx --env-file=.env scripts/local-postgres.ts",
    "test:integration": "tsx --env-file=.env --test tests/integration/*.test.ts",
    "test:browser": "playwright test",
    "format": "prettier --write app lib scripts tests *.ts *.mjs *.json docs/*.md README.md && prisma format"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "google-auth-library": "^10.5.0",
    "next": "^16.4.1",
    "nodemailer": "^10.1.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^7.0.9",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.1",
    "prettier": "^3.9.10",
    "prisma": "6.19.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "overrides": {
    "effect": "^3.20.0",
    "deepmerge-ts": "^8.0.0",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
