generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContactStatus {
  NEW
  VERIFIED
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  SEND_READY
  SENT
  REPLIED
  FAILED
  DO_NOT_CONTACT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  INVALIDATED
}

enum DeliveryStatus {
  BLOCKED
  SIMULATED
  SEND_READY
  SENT
  REPLIED
  FAILED
  SENDING
  UNKNOWN
  TEST_SENT
}

model User {
  id                 String              @id @default(cuid())
  name               String
  email              String              @unique
  passwordHash       String
  active             Boolean             @default(true)
  sessions           Session[]
  approvals          Approval[]
  audits             Audit[]
  plannedDrafts      Draft[]             @relation("DraftOwner")
  campaigns          Campaign[]          @relation("CampaignOwner")
  marketingContents  MarketingContent[]  @relation("ContentOwner")
  marketingApprovals MarketingApproval[] @relation("MarketingReviewer")
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([expiresAt])
}

model LoginAttempt {
  key         String    @id
  failures    Int       @default(0)
  lockedUntil DateTime?
}

model Contact {
  id                 String        @id @default(cuid())
  organisation       String
  industry           String        @default("")
  region             String        @default("")
  firstName          String
  lastName           String
  position           String        @default("")
  email              String        @unique
  personKey          String        @unique
  website            String        @default("")
  sourceUrl          String        @default("")
  verifiedAt         DateTime?
  confidence         String        @default("UNCONFIRMED")
  hook               String        @default("")
  service            String        @default("")
  legalCategory      String        @default("UNASSESSED")
  publicAuthority    Boolean       @default(false)
  newsletterConsent  Boolean       @default(false)
  newsletterEvidence String        @default("")
  status             ContactStatus @default(NEW)
  owner              String        @default("")
  notes              String        @default("")
  revision           Int           @default(1)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  drafts             Draft[]
  legalReviews       LegalReview[]
}

model LegalReview {
  id                  String   @id @default(cuid())
  contactId           String
  contact             Contact  @relation(fields: [contactId], references: [id])
  contactRevision     Int
  allowed             Boolean
  rationale           String
  procurementReviewed Boolean  @default(false)
  userId              String
  createdAt           DateTime @default(now())
}

model Draft {
  campaignId       String?
  campaign         Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  ownerId          String?
  owner            User?          @relation("DraftOwner", fields: [ownerId], references: [id])
  scheduledAt      DateTime?
  planningRevision Int            @default(1)
  id               String         @id @default(cuid())
  contactId        String
  contact          Contact        @relation(fields: [contactId], references: [id])
  version          Int            @default(1)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  versions         DraftVersion[]
  approvals        Approval[]
  deliveries       Delivery[]
}

model DraftVersion {
  id              String   @id @default(cuid())
  draftId         String
  draft           Draft    @relation(fields: [draftId], references: [id])
  version         Int
  recipient       String
  subject         String
  body            String
  hash            String
  contactRevision Int
  authorId        String
  createdAt       DateTime @default(now())

  @@unique([draftId, version])
}

model Approval {
  id        String         @id @default(cuid())
  draftId   String
  draft     Draft          @relation(fields: [draftId], references: [id])
  contactId String
  version   Int
  hash      String
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  status    ApprovalStatus
  createdAt DateTime       @default(now())
}

model Suppression {
  email     String   @id
  reason    String
  userId    String
  createdAt DateTime @default(now())
}

model Delivery {
  id                 String         @id @default(cuid())
  draftId            String
  draft              Draft          @relation(fields: [draftId], references: [id])
  version            Int
  recipient          String
  hash               String
  status             DeliveryStatus
  messageId          String         @unique
  idempotencyKey     String         @unique
  mode               String         @default("LOCAL")
  envelopeRecipients String[]       @default([])
  completedAt        DateTime?
  attempts           Int            @default(1)
  error              String?
  createdAt          DateTime       @default(now())

  @@index([mode, createdAt])
  @@index([recipient, status])
}

model InboundMessage {
  id                String   @id @default(cuid())
  messageId         String   @unique
  inReplyTo         String?
  references        String[]
  deliveryMessageId String?
  receivedAt        DateTime @default(now())
}

model Audit {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entityId  String
  detail    Json
  createdAt DateTime @default(now())
}

// Hub content uses immutable snapshots; publication records never imply API delivery.
enum ContentKind {
  SOCIAL
  NEWSLETTER
}

enum EditorialStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  DONE
}

model Campaign {
  id        String             @id @default(cuid())
  title     String
  goal      String
  audience  String
  startsAt  DateTime
  endsAt    DateTime
  ownerId   String
  owner     User               @relation("CampaignOwner", fields: [ownerId], references: [id])
  revision  Int                @default(1)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  contents  MarketingContent[]
  drafts    Draft[]
}

model MarketingContent {
  id           String              @id @default(cuid())
  kind         ContentKind
  title        String
  version      Int                 @default(1)
  status       EditorialStatus     @default(DRAFT)
  campaignId   String?
  campaign     Campaign?           @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  ownerId      String
  owner        User                @relation("ContentOwner", fields: [ownerId], references: [id])
  scheduledAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  versions     MarketingVersion[]
  approvals    MarketingApproval[]
  publications ManualPublication[]
  exports      NewsletterExport[]

  @@index([campaignId, scheduledAt])
}

model MarketingVersion {
  id        String           @id @default(cuid())
  contentId String
  content   MarketingContent @relation(fields: [contentId], references: [id])
  version   Int
  payload   Json
  hash      String
  authorId  String
  createdAt DateTime         @default(now())

  @@unique([contentId, version])
}

model MarketingApproval {
  id        String           @id @default(cuid())
  contentId String
  content   MarketingContent @relation(fields: [contentId], references: [id])
  version   Int
  hash      String
  userId    String
  user      User             @relation("MarketingReviewer", fields: [userId], references: [id])
  status    ApprovalStatus
  createdAt DateTime         @default(now())
}

model ManualPublication {
  id          String           @id @default(cuid())
  contentId   String
  content     MarketingContent @relation(fields: [contentId], references: [id])
  version     Int
  channel     String
  publishedAt DateTime
  url         String           @default("")
  userId      String
  createdAt   DateTime         @default(now())

  @@unique([contentId, version, channel])
}

model NewsletterExport {
  id        String           @id @default(cuid())
  contentId String
  content   MarketingContent @relation(fields: [contentId], references: [id])
  version   Int
  userId    String
  format    String           @default("HTML_AND_TEXT")
  createdAt DateTime         @default(now())
}
