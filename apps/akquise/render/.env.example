# Reference only: configure in Render Environment; never upload a local .env.
# NODE_VERSION and fixed safe settings are already defined in ../render.yaml.
NODE_ENV=production
PORT=10000
# Optional: leave unset for Render's generated HTTPS URL via RENDER_EXTERNAL_URL.
# Set to the canonical HTTPS origin only when a custom domain is actually configured.
APP_URL=
# Injected from the managed database's INTERNAL connection string by Blueprint.
DATABASE_URL=
# Optional separate migration role/URL; same database, direct connection, no pooler.
MIGRATION_DATABASE_URL=
# Limit the single web instance to three DB connections on the small paid database.
DATABASE_CONNECTION_LIMIT=3
# Required: distinct, real personal login addresses; not SMTP credentials.
MARTIN_EMAIL=
NORA_EMAIL=
MAIL_MODE=disabled
ENABLE_EMAIL_SENDING=false
SMTP_CONFIGURATION_CONFIRMED=false
SMTP_HOST=jovinus.metanet.ch
SMTP_USER=njeker@studiojeker.ch
MAIL_FROM=njeker@studiojeker.ch
# DO NOT set SMTP_PASSWORD. The Render V1 entrypoint refuses it.
# Port/TLS remain unconfirmed and unused; no SMTP or IMAP process is started.
DAILY_SEND_LIMIT=20
# Optional read-only Sheets import: add all credentials server-side only if used.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Kontakte!A1:N501
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
