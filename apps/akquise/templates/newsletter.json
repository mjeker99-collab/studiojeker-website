{
  "source": "Adapted from mailchimp/studiojeker-newsletter-template.html; brand CSS retained, editorial demo sections removed.",
  "html": "<!DOCTYPE html><html lang=\"de-CH\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>{{subject}}</title><style type=\"text/css\">\n    /* Brand tokens from styles/tokens.css\n       --color-black: #000000\n       --color-white: #ffffff\n       --color-cyan:  #00c8ff\n       --color-silver:#c8ccd0\n       --color-neutral:#f5f5f5\n       Grey meta/eyebrows: #6b6f74 (near logo grey #494C50, lighter for meta)\n       Fonts: Arial / Helvetica (web: Inter / Manrope)\n       Layout authority: final newsletter mockup (text and images never overlap)\n    */\n    :root {\n      color-scheme: light only;\n      supported-color-schemes: light only;\n    }\n    body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }\n    table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; border-collapse: collapse; }\n    img { -ms-interpolation-mode: bicubic; border: 0; outline: none; text-decoration: none; display: block; }\n    body {\n      margin: 0 !important;\n      padding: 0 !important;\n      width: 100% !important;\n      background-color: #ffffff;\n      color: #000000;\n    }\n\n    /* Mailchimp / client typography reset — keep compact line-heights */\n    h1, h2, h3, h4, p {\n      margin: 0 !important;\n      padding: 0 !important;\n    }\n    .sj-hero-headline { line-height: 32px !important; }\n    .sj-hero-emphasis { line-height: 34px !important; }\n    .sj-section-headline { line-height: 30px !important; }\n    .sj-pos-headline { line-height: 31px !important; }\n    .sj-body, .sj-body p { line-height: 22px !important; }\n\n    a { color: #000000; text-decoration: none; }\n    a:hover { color: #00c8ff !important; }\n    .sj-link:hover { color: #00c8ff !important; }\n    .sj-cta:hover { color: #00c8ff !important; }\n    u + #body a { color: inherit; }\n    #MessageViewBody a { color: inherit; text-decoration: none; }\n\n    [data-ogsc] body,\n    [data-ogsc] .sj-shell,\n    [data-ogsc] .sj-footer {\n      background-color: #ffffff !important;\n      color: #000000 !important;\n    }\n\n    @media only screen and (max-width: 620px) {\n      .sj-outer { width: 100% !important; }\n      .sj-container { width: 100% !important; max-width: 100% !important; }\n      .sj-pad { padding-left: 22px !important; padding-right: 22px !important; }\n      .sj-pad-lg { padding-left: 22px !important; padding-right: 22px !important; }\n      .sj-stack { display: block !important; width: 100% !important; max-width: 100% !important; }\n      .sj-stack-pad { padding-left: 0 !important; padding-right: 0 !important; padding-bottom: 0 !important; }\n      .sj-stack-pad-right { padding-left: 0 !important; padding-right: 0 !important; padding-top: 0 !important; }\n      .sj-img-fluid { width: 100% !important; height: auto !important; max-width: 100% !important; }\n      .sj-hero-headline { font-size: 30px !important; line-height: 30px !important; }\n      .sj-hero-emphasis { font-size: 32px !important; line-height: 31px !important; }\n      .sj-section-headline { font-size: 26px !important; line-height: 27px !important; }\n      .sj-pos-headline { font-size: 26px !important; line-height: 26px !important; }\n      .sj-body { font-size: 16px !important; line-height: 22px !important; }\n      .sj-body p { margin: 0 0 14px 0 !important; line-height: 22px !important; }\n      .sj-eyebrow { font-size: 11px !important; line-height: 1.35 !important; }\n      .sj-cta { font-size: 13px !important; line-height: 48px !important; min-height: 48px !important; }\n      .sj-meta-left,\n      .sj-meta-right { display: block !important; width: 100% !important; text-align: left !important; padding-bottom: 6px !important; font-size: 11px !important; }\n      .sj-header-logo,\n      .sj-header-claim { display: block !important; width: 100% !important; text-align: left !important; }\n      .sj-header-logo img { width: 130px !important; max-width: 130px !important; height: auto !important; }\n      .sj-claim { text-align: left !important; padding-top: 14px !important; padding-left: 0 !important; font-size: 12px !important; }\n      .sj-pos-left,\n      .sj-pos-right { display: block !important; width: 100% !important; max-width: 100% !important; padding-left: 0 !important; padding-right: 0 !important; }\n      .sj-pos-divider { display: none !important; width: 0 !important; max-width: 0 !important; font-size: 0 !important; line-height: 0 !important; overflow: hidden !important; height: 0 !important; }\n      .sj-pos-right { padding-top: 28px !important; }\n      .sj-comp-pair { display: block !important; width: 100% !important; max-width: 100% !important; padding-left: 0 !important; padding-right: 0 !important; }\n      .sj-comp-item { padding-bottom: 28px !important; }\n      .sj-comp-title { font-size: 12px !important; line-height: 1.4 !important; }\n      .sj-cyan-bar { width: 8px !important; max-width: 8px !important; }\n      .sj-footer-nav,\n      .sj-footer-social,\n      .sj-footer-logo-cell,\n      .sj-footer-claim { display: block !important; width: 100% !important; text-align: left !important; padding-left: 0 !important; padding-right: 0 !important; }\n      .sj-footer-nav { padding-top: 20px !important; font-size: 12px !important; line-height: 2 !important; }\n      .sj-footer-nav a { display: inline-block !important; padding: 4px 12px 4px 0 !important; }\n      .sj-footer-social { padding-top: 16px !important; }\n      .sj-footer-social img { width: 28px !important; height: 28px !important; }\n      .sj-footer-claim { padding-top: 12px !important; font-size: 12px !important; }\n      .sj-footer-logo-cell img { width: 140px !important; max-width: 140px !important; height: auto !important; }\n      .sj-footer-bottom-left,\n      .sj-footer-bottom-right { display: block !important; width: 100% !important; text-align: left !important; font-size: 13px !important; line-height: 1.6 !important; }\n      .sj-footer-bottom-right { padding-top: 14px !important; }\n      .sj-text-col-pad { padding: 32px 22px 36px 18px !important; }\n      .sj-spacer { height: 40px !important; line-height: 40px !important; }\n      .sj-spacer-sm { height: 36px !important; line-height: 36px !important; }\n    }\n\n    /* Narrow phones: single-column competency tiles for readability */\n    @media only screen and (max-width: 359px) {\n      .sj-comp-item { display: block !important; width: 100% !important; max-width: 100% !important; padding-left: 0 !important; padding-right: 0 !important; }\n      .sj-hero-headline { font-size: 28px !important; line-height: 28px !important; }\n      .sj-hero-emphasis { font-size: 30px !important; line-height: 29px !important; }\n      .sj-section-headline { font-size: 24px !important; line-height: 25px !important; }\n      .sj-pos-headline { font-size: 24px !important; line-height: 24px !important; }\n    }\n  </style></head><body style=\"margin:0;background:#ffffff;color:#000000;font-family:Arial,Helvetica,sans-serif\"><div style=\"display:none;max-height:0;overflow:hidden\">{{preheader}}</div><table role=\"presentation\" width=\"100%\"><tr><td align=\"center\"><table role=\"presentation\" width=\"600\" style=\"width:100%;max-width:600px\"><tr><td style=\"padding:28px;font-size:28px;font-weight:bold\">studiojeker®</td></tr><tr><td style=\"padding:28px;border-left:8px solid #00c8ff\"><h1 style=\"font-size:30px\">{{subject}}</h1></td></tr><tr><td style=\"padding:28px;font-size:16px;line-height:1.6\">{{body}}</td></tr><tr><td style=\"padding:28px;border-top:1px solid #c8ccd0;font-size:12px\">Studiojeker GmbH · <a href=\"https://www.studiojeker.ch/\">studiojeker.ch</a><br>*|LIST:ADDRESS|*<br><a href=\"*|UNSUB|*\">Newsletter abbestellen</a> · <a href=\"*|UPDATE_PROFILE|*\">Einstellungen ändern</a></td></tr></table></td></tr></table></body></html>"
}
