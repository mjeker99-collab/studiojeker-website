# Studiojeker — Apache / Plesk static hosting
# Copied into `/out` via the Next.js `public/` directory on build.
# Requires: AllowOverride + mod_rewrite + mod_headers (typical Plesk defaults).
#
# Legacy 301 map (maintain alongside docs/LEGACY_URL_REDIRECTS.md):
# WordPress + interim IA → Next.js static export. Trailing-slash targets avoid
# a second hop. QSA keeps query strings. NC tolerates legacy casing.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Do not rewrite real files/dirs from the static export (assets, existing pages).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # =========================================================================
  # A) Interim Next IA — known thematic targets only (no bare homepage dumps)
  # Bare /services/, /solutions/, /en/services/, /en/solutions/ → intentional 404
  # =========================================================================
  RewriteRule ^solutions/brand-business/?$ /services/business-communication/ [R=301,L,QSA,NC]
  RewriteRule ^en/solutions/brand-business/?$ /en/services/business-communication/ [R=301,L,QSA,NC]
  RewriteRule ^solutions/products-industry/?$ /services/product-communication/ [R=301,L,QSA,NC]
  RewriteRule ^en/solutions/products-industry/?$ /en/services/product-communication/ [R=301,L,QSA,NC]
  RewriteRule ^solutions/architecture-real-estate/?$ /services/architecture/ [R=301,L,QSA,NC]
  RewriteRule ^en/solutions/architecture-real-estate/?$ /en/services/architecture/ [R=301,L,QSA,NC]
  RewriteRule ^solutions/social-digital-marketing/?$ /services/digital-marketing/ [R=301,L,QSA,NC]
  RewriteRule ^en/solutions/social-digital-marketing/?$ /en/services/digital-marketing/ [R=301,L,QSA,NC]

  RewriteRule ^solutions/sichtbarkeit-im-abo/?$ /content-abo/ [R=301,L,QSA,NC]
  RewriteRule ^en/solutions/sichtbarkeit-im-abo/?$ /en/content-subscription/ [R=301,L,QSA,NC]
  RewriteRule ^de/content-abo/?$ /content-abo/ [R=301,L,QSA,NC]

  RewriteRule ^references(/.*)?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^en/references(/.*)?$ /en/work/ [R=301,L,QSA,NC]

  # =========================================================================
  # B) WordPress — company / contact / legal utilities
  # Exact page matches only (attachment subpaths under team/partners stay 404)
  # =========================================================================
  RewriteRule ^kontakt/?$ /contact/ [R=301,L,QSA,NC]
  RewriteRule ^team/?$ /about/ [R=301,L,QSA,NC]
  RewriteRule ^jobs/?$ /about/ [R=301,L,QSA,NC]
  RewriteRule ^fotostudio/?$ /about/ [R=301,L,QSA,NC]
  RewriteRule ^mobiles-fotostudio/?$ /about/ [R=301,L,QSA,NC]
  RewriteRule ^partners/?$ /about/ [R=301,L,QSA,NC]
  RewriteRule ^foteri/?$ /about/ [R=301,L,QSA,NC]

  RewriteRule ^referenzen/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^projects/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^project/?$ /work/ [R=301,L,QSA,NC]

  RewriteRule ^content-workshop/?$ /content-abo/ [R=301,L,QSA,NC]
  RewriteRule ^newslatter-bestellen/?$ /contact/ [R=301,L,QSA,NC]
  RewriteRule ^newsletter-anmeldung/?$ /contact/ [R=301,L,QSA,NC]
  RewriteRule ^danke/?$ /contact/ [R=301,L,QSA,NC]
  RewriteRule ^privacy-policy/?$ /datenschutz/ [R=301,L,QSA,NC]

  # Allowed homepage redirect for obsolete WP home alias
  RewriteRule ^home-2/?$ / [R=301,L,QSA,NC]

  # /impressum/ and /datenschutz/ exist on both sites — no redirect.
  # /suche/, /sitemap/ — intentional 404 (no homepage dump).
  # /agb_studiojeker_2015/ — new site has /agb/; legacy redirect not enabled yet.
  # /author/flutura-admin/ — intentional 404.

  # =========================================================================
  # C) WordPress service pages + service-context attachment subpaths
  # Patterns cover /slug/ and /slug/.../ ; new-site routes use different paths.
  # =========================================================================
  # Business communication
  RewriteRule ^businessfotografie(/.*)?$ /services/business-communication/ [R=301,L,QSA,NC]
  RewriteRule ^eventfotografie(/.*)?$ /services/business-communication/ [R=301,L,QSA,NC]
  RewriteRule ^imagefilm(/.*)?$ /services/business-communication/ [R=301,L,QSA,NC]
  RewriteRule ^filmproduktion(/.*)?$ /services/business-communication/ [R=301,L,QSA,NC]

  # Product communication
  RewriteRule ^produktfotografie(/.*)?$ /services/product-communication/ [R=301,L,QSA,NC]
  RewriteRule ^werbefotografie(/.*)?$ /services/product-communication/ [R=301,L,QSA,NC]
  RewriteRule ^uhrenfotografie(/.*)?$ /services/product-communication/ [R=301,L,QSA,NC]
  RewriteRule ^industriefotografie(/.*)?$ /services/product-communication/ [R=301,L,QSA,NC]
  RewriteRule ^produktvideo(/.*)?$ /services/product-communication/ [R=301,L,QSA,NC]
  RewriteRule ^3d-animation(/.*)?$ /services/product-communication/ [R=301,L,QSA,NC]
  RewriteRule ^3danimation(/.*)?$ /services/product-communication/ [R=301,L,QSA,NC]
  RewriteRule ^3d-produktanimation(/.*)?$ /services/product-communication/ [R=301,L,QSA,NC]

  # Architecture & real estate
  RewriteRule ^architekturfotografie(/.*)?$ /services/architecture/ [R=301,L,QSA,NC]
  RewriteRule ^architekturvisualisierung(/.*)?$ /services/architecture/ [R=301,L,QSA,NC]
  RewriteRule ^drohnenaufnahmen(/.*)?$ /services/architecture/ [R=301,L,QSA,NC]

  # Digital marketing
  RewriteRule ^social-media(/.*)?$ /services/digital-marketing/ [R=301,L,QSA,NC]
  RewriteRule ^erklarvideos(/.*)?$ /services/digital-marketing/ [R=301,L,QSA,NC]
  RewriteRule ^werbespots(/.*)?$ /services/digital-marketing/ [R=301,L,QSA,NC]
  RewriteRule ^augmented-reality(/.*)?$ /services/digital-marketing/ [R=301,L,QSA,NC]
  RewriteRule ^ar-app(/.*)?$ /services/digital-marketing/ [R=301,L,QSA,NC]
  RewriteRule ^metaverse(/.*)?$ /services/digital-marketing/ [R=301,L,QSA,NC]

  # =========================================================================
  # D) WordPress categories → thematic service targets only (no homepage dump)
  # /category/ar/, /category/uncategorized/ → intentional 404
  # =========================================================================
  RewriteRule ^category/businessfotografie/?$ /services/business-communication/ [R=301,L,QSA,NC]
  RewriteRule ^category/imagefilm/?$ /services/business-communication/ [R=301,L,QSA,NC]
  RewriteRule ^category/filmproduktion/?$ /services/business-communication/ [R=301,L,QSA,NC]
  RewriteRule ^category/eventfotografie/?$ /services/business-communication/ [R=301,L,QSA,NC]

  RewriteRule ^category/produktfotografie/?$ /services/product-communication/ [R=301,L,QSA,NC]
  RewriteRule ^category/werbefotografie/?$ /services/product-communication/ [R=301,L,QSA,NC]
  RewriteRule ^category/uhrenfotografie/?$ /services/product-communication/ [R=301,L,QSA,NC]
  RewriteRule ^category/industriefotografie/?$ /services/product-communication/ [R=301,L,QSA,NC]
  RewriteRule ^category/produktvideo/?$ /services/product-communication/ [R=301,L,QSA,NC]
  RewriteRule ^category/3d-animation/?$ /services/product-communication/ [R=301,L,QSA,NC]
  RewriteRule ^category/3d-produktanimation/?$ /services/product-communication/ [R=301,L,QSA,NC]

  RewriteRule ^category/architekturfotografie/?$ /services/architecture/ [R=301,L,QSA,NC]
  RewriteRule ^category/visualisierung/?$ /services/architecture/ [R=301,L,QSA,NC]
  RewriteRule ^category/drohnenaufnahmen/?$ /services/architecture/ [R=301,L,QSA,NC]

  RewriteRule ^category/erklarvideos/?$ /services/digital-marketing/ [R=301,L,QSA,NC]
  RewriteRule ^category/werbespots/?$ /services/digital-marketing/ [R=301,L,QSA,NC]
  RewriteRule ^category/ar-app/?$ /services/digital-marketing/ [R=301,L,QSA,NC]

  # =========================================================================
  # E) WordPress portfolio / showreel posts → /work/ (direct, no chains)
  # =========================================================================
  RewriteRule ^titoni/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^titoni-seascoper/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^arthur-flury-ag/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^sphinx-tools-medical/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^metalldruckerei/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^hotel-wellenberg/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^digmesa/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^certina/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^optotech/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^sanitized-comfort/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^bijoux-stadelmann/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^ccm-erklarvideo/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^thai-suppe/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^fit-werkstattwagen/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^jura-impressa-j9/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^aerial-drohnen-showreel/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^produktfotografie-showreel/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^architekturfotografie-showreel/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^stromwatches/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^agathon-dom-plus/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^event-showreel/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^endress-hauser/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^heiniger-produktanimation/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^magiclens-ar-app/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^magic-lens-demo/?$ /work/ [R=301,L,QSA,NC]

  # =========================================================================
  # F) WordPress tags → /work/ (safe: new site has no /tag/ routes)
  # All 24 known tag slugs from live WP REST (explicit list).
  # =========================================================================
  RewriteRule ^tag/agathon/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^tag/arthur-flury-ag/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^tag/bijoux-stadelmann/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^tag/ccm/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^tag/certina-spot/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^tag/digmesa-nano-flowmeter/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^tag/endresshauser/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^tag/fit-werkstattwagen/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^tag/hamilton/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^tag/heiniger-ag/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^tag/hotel-wellenberg/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^tag/johann-eichler-ag/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^tag/jura/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^tag/magic-lens/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^tag/n-a/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^tag/optotech-deboxer/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^tag/rado/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^tag/sanitized/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^tag/sanitized-produktfilm/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^tag/sphinx-tools-medical/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^tag/stromwatches/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^tag/takeda-medical-campus/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^tag/thai-suppe/?$ /work/ [R=301,L,QSA,NC]
  RewriteRule ^tag/titoni/?$ /work/ [R=301,L,QSA,NC]
</IfModule>

<IfModule mod_headers.c>
  # Security headers (static export cannot use next.config headers())
  # Keep in sync with lib/security/headers.ts — Vimeo + youtube-nocookie only
  # (no youtube.com / google.com wildcards).
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://i.vimeocdn.com https://cdn.sanity.io; font-src 'self'; connect-src 'self'; frame-src 'self' https://player.vimeo.com https://vimeo.com https://www.youtube-nocookie.com; child-src 'self' https://player.vimeo.com https://vimeo.com https://www.youtube-nocookie.com; media-src 'self' blob:; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set X-DNS-Prefetch-Control "off"
  Header unset X-Powered-By
</IfModule>

# Prefer UTF-8
AddDefaultCharset UTF-8

# Homepage / route HTML must revalidate quickly so clients pick up JS that
# refreshes CMS content via /api/homepage.php (static export has no ISR).
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# Cache immutable Next assets aggressively when present
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/avif "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
